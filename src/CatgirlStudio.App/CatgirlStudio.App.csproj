<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WPF's text layout needs culture data, so not invariant like the other projects -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>CatgirlStudio.App</RootNamespace>
    <AssemblyName>CatgirlStudio</AssemblyName>
    <!-- LibraryImport (the dark title bar call) generates its marshalling as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Icon shown by Explorer and the taskbar for the executable (from vD-Resources: neko-purple-light). -->
    <ApplicationIcon>Resources\neko-purple-light.ico</ApplicationIcon>

    <!--
      The default publish uses the installed .NET Desktop Runtime.
      A self-contained publish embeds the native runtime libraries in the executable.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(SelfContained)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The catalog ships inside the executable (single-file publish has no loose files).
    -->
    <EmbeddedResource Include="..\..\data\catalog.json" LogicalName="CatgirlStudio.catalog.json" />
    <EmbeddedResource Include="..\..\data\prefabs.json" LogicalName="CatgirlStudio.prefabs.json" />
    <EmbeddedResource Include="..\..\data\outfits.json" LogicalName="CatgirlStudio.outfits.json" />
    <!-- window icon, as a WPF resource (pack URI) -->
    <Resource Include="Resources\neko-purple-light.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CatgirlStudio.Core\CatgirlStudio.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyBundledRuntimeNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_CoreRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_DesktopRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
    </ItemGroup>
    <Copy SourceFiles="@(_CoreRuntimePack->'%(PackageDirectory)/LICENSE.TXT')" DestinationFiles="$(PublishDir)licenses/dotnet-runtime-LICENSE.txt" />
    <Copy SourceFiles="@(_CoreRuntimePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" DestinationFiles="$(PublishDir)licenses/dotnet-runtime-THIRD-PARTY-NOTICES.txt" />
    <Copy SourceFiles="@(_DesktopRuntimePack->'%(PackageDirectory)/LICENSE')" DestinationFiles="$(PublishDir)licenses/dotnet-desktop-LICENSE.txt" />
  </Target>

</Project>
